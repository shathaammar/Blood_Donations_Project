@model Blood_Donations_Project.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Home";
    var role = Model.Role ?? "";
}
@if (string.IsNullOrWhiteSpace(role))
{
    <div class="alert alert-warning mt-4">
        You are not logged in. Please <a href="/Account/Login">login</a>.
    </div>
}
else if (Model.Admin != null)
{
    <partial name="~/Views/Shared/_AdminDashboard.cshtml" model="Model.Admin" />
}
else if (Model.Donor != null)
{
    <partial name="~/Views/Shared/_DonorDashboard.cshtml"
             model="Model.Donor" />
}

else if (Model.Hospital != null)
{
    <partial name="~/Views/Shared/_HospitalDashboard.cshtml" model="Model.Hospital" />
}
else
{
    <div class="alert alert-secondary mt-4">
        Unknown role: <strong>@role</strong>
    </div>
}